[
  {
    "id": "P01",
    "ruleType": "approval",
    "rule": {
      "always": true,
      "add_step": "DEPARTMENT_APPROVER"
    },
    "sourceText": "Invoice total up to $10,000 CAD -> dept_manager"
  },
  {
    "id": "P02",
    "ruleType": "approval",
    "rule": {
      "if": {
        "field": "total_cad",
        "op": ">",
        "value": 10000
      },
      "add_step": "ADMIN",
      "note": "finance manager"
    },
    "sourceText": "Invoice total over $10,000 CAD -> dept_manager > finance_manager"
  },
  {
    "id": "P03",
    "ruleType": "approval",
    "rule": {
      "if": {
        "field": "total_cad",
        "op": ">",
        "value": 50000
      },
      "add_step": "ADMIN",
      "note": "controller"
    },
    "sourceText": "Invoice total over $50,000 CAD -> ... > controller_admin"
  },
  {
    "id": "P04",
    "ruleType": "approval",
    "rule": {
      "if": {
        "field": "total_cad",
        "op": ">",
        "value": 250000
      },
      "add_step": "ADMIN",
      "note": "CFO"
    },
    "sourceText": "Invoice total over $250,000 CAD -> ... > cfo"
  },
  {
    "id": "P05",
    "ruleType": "approval",
    "rule": {
      "if": {
        "field": "vendor.status",
        "op": "in",
        "value": [
          "pending_review",
          "new"
        ]
      },
      "add_step": "ADMIN"
    },
    "sourceText": "Vendor status is pending_review or the vendor is new -> finance_manager"
  },
  {
    "id": "P06",
    "ruleType": "approval",
    "rule": {
      "if": {
        "field": "vendor.category",
        "op": "==",
        "value": "Legal"
      },
      "add_step": "ADMIN"
    },
    "sourceText": "Vendor category is Legal -> finance_manager"
  },
  {
    "id": "P07",
    "ruleType": "approval",
    "rule": {
      "enforced_in": "ApprovalRoutingNode.resolve + AuthorizationService (no self-approval)"
    },
    "sourceText": "Requester is the approver -> approver's manager"
  },
  {
    "id": "P08",
    "ruleType": "approval",
    "rule": {
      "enforced_in": "ApprovalRoutingNode.resolve (delegate + acting_for)"
    },
    "sourceText": "Approver is on leave -> delegate_user_id"
  },
  {
    "id": "P09",
    "ruleType": "payment_release",
    "rule": {
      "enforced_in": "simplified: any Admin may release any payment (AuthorizationService)"
    },
    "sourceText": "Payment up to $100,000 CAD -> finance_manager (AP clerks prepare, cannot release)"
  },
  {
    "id": "P10",
    "ruleType": "payment_release",
    "rule": {
      "enforced_in": "simplified: any Admin may release any payment (AuthorizationService)"
    },
    "sourceText": "Payment over $100,000 CAD -> controller_admin"
  },
  {
    "id": "P11",
    "ruleType": "payment_release",
    "rule": {
      "enforced_in": "AuthorizationService (approver != releaser)"
    },
    "sourceText": "Always -> not the invoice approver"
  },
  {
    "id": "P12",
    "ruleType": "match",
    "rule": {
      "enforced_in": "ValidationRulesNode (TODO: PO balance check)"
    },
    "sourceText": "Invoice references a PO -> total within PO remaining balance"
  },
  {
    "id": "P13",
    "ruleType": "match",
    "rule": {
      "enforced_in": "ValidationRulesNode (TODO: vendors.requires_po)"
    },
    "sourceText": "Vendor category requires a PO -> PO number present"
  }
]
