# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Gemini key: https://aistudio.google.com/apikey (OPENROUTER_API_KEY still works as a fallback name)
LLM_API_KEY=

# Gemini's OpenAI-compatible endpoint. Model needs vision (images/PDF) for extraction.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash

# manual = read the PDF text layer with rules, no LLM calls (default); llm = read documents with the model above
EXTRACTOR=manual
