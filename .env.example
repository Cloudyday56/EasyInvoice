# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Your OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model id. Needs vision (images/PDF) for extraction.
LLM_MODEL=anthropic/claude-sonnet-4.5

# fake = no LLM calls (default), llm = read documents with the model above
EXTRACTOR=fake
